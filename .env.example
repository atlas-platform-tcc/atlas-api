# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# GitHub token with `repo` + `workflow` scopes (enables repository provisioning).
GITHUB_TOKEN=

# Optional overrides:
# PORT=8080
# ATLAS_DB=atlas.db
# ATLAS_ORG=atlas-platform-tcc
# ATLAS_TEMPLATES_REPO=atlas-templates
# ATLAS_TEMPLATES_REF=main
# ATLAS_TEMPLATE_DIR=go-service-template
# ATLAS_INFRA_REPO=atlas-infra
# ATLAS_GITOPS_REPO=atlas-gitops
# ATLAS_GITOPS_REF=main
# ATLAS_CHART_PATH=charts/base
