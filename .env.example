# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# GitHub token with `repo` + `workflow` scopes (enables repository provisioning).
GITHUB_TOKEN=

# Optional overrides:
# PORT=8081
# ATLAS_DB=atlas.db
# ATLAS_ORG=atlas-platform-tcc
# ATLAS_TEMPLATES_REPO=atlas-templates
# ATLAS_TEMPLATES_REF=main
# ATLAS_TEMPLATE_DIR=go-service-template
# ATLAS_INFRA_REPO=atlas-infra
# ATLAS_GITOPS_REPO=atlas-gitops
# ATLAS_GITOPS_REF=main
# ATLAS_CHART_PATH=charts/base
# ATLAS_INGRESS_DOMAIN=127.0.0.1.nip.io

# Optional observed state (sync/health) read from Argo CD (ADR atlas-api/0012).
# Unset -> the catalog serves the projected (git) state only.
# ARGOCD_ADDR=https://localhost:8083
# ARGOCD_TOKEN=
# ARGOCD_INSECURE=true
# ATLAS_OBSERVE_INTERVAL=30s   # de quanto em quanto o poller lê o Argo CD e emite eventos argocd.*
